{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.bat",
      "**/*.sh",
      "**/*.exe",
      "**/*.cmd",
      "**/*.bin",
      "**/*.php",
      "**/*.py",
      "**/*.ps1",
      "**/*.apk",
      "**/*.dmg",
      "**/*.pkg",
      "**/*.deb",
      "**/*.rpm",
      "**/*.msi",
      "scripts/**",
      "server.js",
      "package*.json",
      "tsconfig.json",
      "vite.config.ts"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/control",
        "destination": "/controller.html"
      },
      {
        "source": "/scoreboard",
        "destination": "/Scoreboard.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(mp3|wav|ogg|mp4|webm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000"
          },
          {
            "key": "Accept-Ranges",
            "value": "bytes"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
